#: optimize_images_x/global_setup.py:41 optimize_images_x/gui/main_window.py:76
msgid "Optimize Images X"
msgstr "Optimize Images X"

#: optimize_images_x/global_setup.py:45
msgid "MIT License"
msgstr "Licença MIT"

#: optimize_images_x/global_setup.py:54
msgid ""
"Optimize Images X was initially created by Victor Domingos and both inspired "
"and made possible by the work of many other developers, including the makers "
"of existing image processing utilities, Pillow, as well as the direct "
"contibutors to this project and to it's parent application, Optimize Images "
"(the CLI version)."
msgstr ""
"O Optimize Images X foi inicialmente criado por Victor Domingos e inspirado "
"bem como tornado possível pelo trabalho de muitos outros programadores, "
"incluindo os criadores dos utilitários existentes de processamento de "
"imagens, do Pillow, tal como os contribuidores diretos deste projeto e da "
"sua aplicação mãe, Optimize Images (a versão CLI)."

